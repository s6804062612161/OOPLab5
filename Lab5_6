import java.util.Scanner;

public class ConsecutiveFourLab5 {
    public static boolean isConsecutiveFour(int[][] values) {
        int rows = values.length;
        int cols = values.length;

        for (int r = 0; r < rows; r++) {
            for (int c = 0; c < cols; c++) {
                int val = values[r][c];

                if (c + 3 < cols && val == values[r][c+1] && val == values[r][c+2] && val == values[r][c+3])
                    return true;

                if (r + 3 < rows && val == values[r+1][c] && val == values[r+2][c] && val == values[r+3][c])
                    return true;

                if (r + 3 < rows && c + 3 < cols && val == values[r+1][c+1] && val == values[r+2][c+2] && val == values[r+3][c+3])
                    return true;

                if (r + 3 < rows && c - 3 >= 0 && val == values[r+1][c-1] && val == values[r+2][c-2] && val == values[r+3][c-3])
                    return true;
            }
        }
        return false;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (!sc.hasNextInt()) return;
        int rows = sc.nextInt();
        int cols = sc.nextInt();
        int[][] values = new int[rows][cols];

        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < cols; j++) {
                values[i][j] = sc.nextInt();
            }
        }

        if (isConsecutiveFour(values)) {
            System.out.println(1);
        } else {
            System.out.println(0);
        }
    }
}
