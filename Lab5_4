import java.util.Scanner;

public class KIB {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int M = sc.nextInt();
        int N = sc.nextInt();
        int K = sc.nextInt();

        int[][] grid = new int[M][N];
        for (int i = 0; i < M; i++) {
            for (int j = 0; j < N; j++) {
                grid[i][j] = sc.nextInt();
            }
        }

        int maxPopulation = 0;
        for (int i = 0; i <= M - K; i++) {
            for (int j = 0; j <= N - K; j++) {
                int sum = 0;
                for (int r = i; r < i + K; r++) {
                    for (int c = j; c < j + K; c++) {
                        sum += grid[r][c];
                    }
                }
                if (sum > maxPopulation) {
                    maxPopulation = sum;
                }
            }
        }
        System.out.println(maxPopulation);
    }
}
